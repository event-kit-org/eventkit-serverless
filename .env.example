# eventkit-serverless: set these in the Vercel project (Production), not in a file.
# This list is the reference. Region: bom1 (Mumbai), next to Supabase ap-south-1.
NODE_ENV=production
LOG_LEVEL=info

# Supabase Postgres (ap-south-1).
# DATABASE_URL: the transaction pooler, port 6543 (runtime).
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=
# Each warm function instance holds its own small pool.
DATABASE_POOL_MAX=1
# DIRECT_URL: the direct connection, only for migrations. A GitHub Actions
# secret (the deploy job runs `npm run migrate`), not a Vercel variable.
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true
DIRECT_URL=

# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# The key the hosted front end sends in X-Api-Key (VITE_PLATFORM_API_KEY there).
PLATFORM_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=eventkit
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL=300

BILLING_PROVIDER=free

# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# GitHub Actions secrets for the deploy job (not Vercel variables):
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, DIRECT_URL
# Vercel build: none needed; the build runs in GitHub Actions (vercel build).

# Email over SMTP (optional; off unless host, user and password are set).
# Gmail: smtp.gmail.com, port 465, and an app password for the account
# (Google Account → Security → 2-Step Verification → App passwords).
# Sends the team leader a registration email when the event has mailing on.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=eventKit <mail.eventkit@gmail.com>
